# agents-repo ortam değişkenleri
# Şablon: kopyala → .env → doldur. .env asla commit edilmez.
# Sadece kullandığın sağlayıcıların anahtarlarını doldur; hepsi opsiyonel.

# --- Sistem ---
NODE_ID=hermes # Düğüm kimliği: log kayıtlarında düğüm etiketi (örn: hermes, ev, laptop)

# --- LLM Sağlayıcıları (direkt anahtarlar, tek anahtar modeli yok) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# --- Yerel modeller ---
OLLAMA_HOST=http://localhost:11434

# --- Telegram (ingest kanalı — düğüm gateway'i) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Git / Pull Request akışı ---
# Agent'lerin branch açıp PR oluşturması için fine-grained PAT
# (Contents: Read/Write, Pull requests: Read/Write)
GITHUB_TOKEN=
GITHUB_REPO=
GIT_USER_NAME=
GIT_USER_EMAIL=
