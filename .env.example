# agents-repo ortam değişkenleri
# Şablon: kopyala → .env → doldur. .env asla commit edilmez.
# Sadece kullandığın sağlayıcıların anahtarlarını doldur; hepsi opsiyonel.

# --- Sistem ---
NODE_ID=hermes # Düğüm kimliği: log kayıtlarında düğüm etiketi (örn: hermes, ev, laptop)
NOMA_ACTOR= # Varsayılan log aktörü (SCHEMA §5); CLI'da --actor verilmezse kullanılır

# --- LLM Sağlayıcıları (direkt anahtarlar, tek anahtar modeli yok) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GLM_API_KEY= # z.ai coding plan (Hermes provider: zai) — B3 doğrulandı 2026-09-23

# --- Yerel modeller ---
OLLAMA_HOST=http://localhost:11434

# --- Telegram (ingest kanalı — düğüm gateway'i) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Git (zamanlanmış commit/push — ROADMAP B5, henüz yok) ---
# Tüketicisi olan bir script yok; B5 onaylanana kadar doldurulmaz.
GITHUB_TOKEN=
GITHUB_REPO=
GIT_USER_NAME=
GIT_USER_EMAIL=
