# agents-repo ortam değişkenleri
# Şablon: kopyala → .env → doldur. .env asla commit edilmez.
# Sadece kullandığın sağlayıcıların anahtarlarını doldur; hepsi opsiyonel.

# --- LLM Sağlayıcıları (direkt anahtarlar, tek anahtar modeli yok) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# --- Yerel modeller ---
OLLAMA_HOST=http://localhost:11434

# --- Telegram (Hermes gateway) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Git / Merge Request akışı ---
# Agent'lerin branch açıp MR oluşturması için fine-grained PAT
# (Contents: Read/Write, Pull requests: Read/Write)
GITHUB_TOKEN=
GITHUB_REPO=
GIT_USER_NAME=
GIT_USER_EMAIL=
